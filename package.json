{
  "name": "dsh-wecom-bridge",
  "author": "DeepSeek Harness Community",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "A WeCom (企业微信) smart-robot Source for dsh-superagent: a WebSocket long connection that turns WeCom messages into Tickets, plus a session-title refiner that distills conversation topics and strips model reasoning tags.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wecom-watch": "./lib/wecom-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
